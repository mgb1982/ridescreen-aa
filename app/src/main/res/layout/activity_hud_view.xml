<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/hud_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#000000">

    <!-- Top bar: back, title, Android Auto / Dashboard / Map selector, fullscreen -->
    <LinearLayout
        android:id="@+id/hud_topbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#66000000"
        android:paddingHorizontal="8dp"
        android:paddingVertical="6dp">

        <Button
            android:id="@+id/hud_close"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:minWidth="44dp"
            android:contentDescription="@string/cuadro_back_desc"
            android:text="@string/cuadro_back_glyph"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/hud_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:text="@string/cuadro_title"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/hud_mode_group"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            app:singleSelection="true"
            app:selectionRequired="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/hud_mode_aa"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingHorizontal="4dp"
                android:text="@string/cuadro_mode_aa"
                android:textSize="12sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/hud_mode_dash"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingHorizontal="4dp"
                android:text="@string/cuadro_mode_dashboard"
                android:textSize="12sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/hud_mode_map"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingHorizontal="4dp"
                android:text="@string/cuadro_mode_map"
                android:textSize="12sp" />
        </com.google.android.material.button.MaterialButtonToggleGroup>

        <Button
            android:id="@+id/hud_fullscreen"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:minWidth="44dp"
            android:layout_marginStart="4dp"
            android:contentDescription="@string/cuadro_fullscreen_desc"
            android:text="@string/hud_str_3"
            android:textSize="18sp" />
    </LinearLayout>

    <!-- Portrait: picture above, Mando below. Landscape: orientation is switched to horizontal in code. -->
    <LinearLayout
        android:id="@+id/hud_body"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <FrameLayout
            android:id="@+id/hud_stage"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <SurfaceView
                android:id="@+id/hud_surface"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center" />

            <!-- Phone Map / GPX preview when no bike / AA pipeline (debug + offline) -->
            <FrameLayout
                android:id="@+id/hud_gpx_host"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone" />

            <!-- Shown when there is no bike connection and no Map preview -->
            <TextView
                android:id="@+id/hud_hint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:padding="24dp"
                android:text="@string/cuadro_hint_disconnected"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:visibility="gone" />
        </FrameLayout>

        <!-- Mando: handle + pad (works on every dash via the AAP INPUT channel) -->
        <ScrollView
            android:id="@+id/hud_controls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#99000000"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="8dp"
                android:paddingBottom="8dp">

                <Button
                    android:id="@+id/hud_pad_handle"
                    style="?attr/borderlessButtonStyle"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:text="@string/cuadro_pad_handle_open"
                    android:textColor="#FFFFFF" />

                <LinearLayout
                    android:id="@+id/hud_pad"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout style="@style/CuadroPadRow">
                        <Button android:id="@+id/hud_knob_back" style="@style/CuadroPadKey" android:contentDescription="@string/cuadro_knob_back_desc" android:text="@string/hud_str_4" />
                        <Button android:id="@+id/hud_up" style="@style/CuadroPadKey" android:contentDescription="@string/cuadro_up_desc" android:text="@string/controls_str" />
                        <Button android:id="@+id/hud_knob_fwd" style="@style/CuadroPadKey" android:contentDescription="@string/cuadro_knob_fwd_desc" android:text="@string/hud_str_5" />
                    </LinearLayout>

                    <LinearLayout style="@style/CuadroPadRow">
                        <Button android:id="@+id/hud_left" style="@style/CuadroPadKey" android:contentDescription="@string/cuadro_left_desc" android:text="@string/controls_str_2" />
                        <Button android:id="@+id/hud_ok" style="@style/CuadroPadKey" android:contentDescription="@string/cuadro_ok_desc" android:text="@android:string/ok" />
                        <Button android:id="@+id/hud_right" style="@style/CuadroPadKey" android:contentDescription="@string/cuadro_right_desc" android:text="@string/controls_str_3" />
                    </LinearLayout>

                    <LinearLayout style="@style/CuadroPadRow">
                        <Space android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
                        <Button android:id="@+id/hud_down" style="@style/CuadroPadKey" android:contentDescription="@string/cuadro_down_desc" android:text="@string/controls_str_4" />
                        <Space android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
                    </LinearLayout>

                    <LinearLayout style="@style/CuadroPadRow">
                        <Button android:id="@+id/hud_back" style="@style/CuadroPadKey" android:contentDescription="@string/cuadro_bike_back_desc" android:text="@string/controls_back" android:textSize="14sp" />
                        <Button android:id="@+id/hud_home" style="@style/CuadroPadKey" android:contentDescription="@string/cuadro_bike_home_desc" android:text="@string/controls_home" android:textSize="14sp" />
                        <Button android:id="@+id/hud_voice" style="@style/CuadroPadKey" android:contentDescription="@string/cuadro_voice_desc" android:text="@string/cuadro_pad_voice" android:textSize="14sp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</LinearLayout>
