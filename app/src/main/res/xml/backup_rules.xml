<?xml version="1.0" encoding="utf-8"?>
<!-- RideScreen AA · Android Auto backup (API ≤ 30). Everything is backed up except what must not
     leave the phone: the bike's Wi‑Fi password (inside the saved QR), the phone-hotspot password,
     emergency / arrival contacts, the passenger-mode pairing, the keyless-box code (pke_box) and the
     black-box impact recordings (GPS + motion). After a restore the rider scans the bike QR again. Keep in sync with data_extraction_rules.xml. -->
<full-backup-content>
    <exclude domain="sharedpref" path="opencfmoto_bike.xml" />
    <exclude domain="sharedpref" path="opencfmoto_phone_hotspot.xml" />
    <exclude domain="sharedpref" path="crash_detector.xml" />
    <exclude domain="sharedpref" path="arrival_notice.xml" />
    <exclude domain="sharedpref" path="companion.xml" />
    <exclude domain="sharedpref" path="pke_box.xml" />
    <exclude domain="file" path="blackbox/" />
</full-backup-content>
