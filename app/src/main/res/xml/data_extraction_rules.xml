<?xml version="1.0" encoding="utf-8"?>
<!-- RideScreen AA · cloud backup and device-to-device transfer (API 31+). Same exclusions as
     backup_rules.xml: Wi‑Fi passwords, emergency / arrival contacts, passenger pairing, keyless-box
     code, the keyless device key (McuID, pke_unlock) and black-box recordings. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="opencfmoto_bike.xml" />
        <exclude domain="sharedpref" path="opencfmoto_phone_hotspot.xml" />
        <exclude domain="sharedpref" path="crash_detector.xml" />
        <exclude domain="sharedpref" path="arrival_notice.xml" />
        <exclude domain="sharedpref" path="companion.xml" />
        <exclude domain="sharedpref" path="pke_box.xml" />
        <exclude domain="sharedpref" path="pke_unlock.xml" />
        <exclude domain="file" path="blackbox/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="opencfmoto_bike.xml" />
        <exclude domain="sharedpref" path="opencfmoto_phone_hotspot.xml" />
        <exclude domain="sharedpref" path="crash_detector.xml" />
        <exclude domain="sharedpref" path="arrival_notice.xml" />
        <exclude domain="sharedpref" path="companion.xml" />
        <exclude domain="sharedpref" path="pke_box.xml" />
        <exclude domain="sharedpref" path="pke_unlock.xml" />
        <exclude domain="file" path="blackbox/" />
    </device-transfer>
</data-extraction-rules>
